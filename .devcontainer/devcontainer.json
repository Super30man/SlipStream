
{
  "name": "Slipstream Gaming Browser",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {
      "moby": false
    }
  },
  "onCreateCommand": "docker pull ghcr.io/linuxserver/chrome:latest",
  "postStartCommand": "bash .devcontainer/launch-chrome.sh && bash .devcontainer/update-check.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Slipstream Browser",
      "protocol": "http",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  }
}
